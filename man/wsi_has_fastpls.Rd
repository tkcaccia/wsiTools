\name{wsi_has_fastpls}
\alias{wsi_has_fastpls}
\title{Check whether fastPLS is available}
\usage{
wsi_has_fastpls()
}
\value{
\code{TRUE} when \code{fastPLS} can be loaded, otherwise \code{FALSE}.
}
\description{
\code{wsi_has_fastpls()} reports whether the optional GitHub package
\code{tkcaccia/fastPLS} is installed. It is only needed for the live viewer
\strong{Prediction} menu; wsiTools can be installed and used without it.
}
